# Copy to .env and fill in. Mode 0600. The file holds secrets.

# Public origin of the account service. It must use HTTPS, because the OIDC redirect
# URI uses it. `http://127.0.0.1:PORT` is allowed for a local test.
OPENBOT_ACCOUNT_PUBLIC_URL=https://account.example.com
OPENBOT_ACCOUNT_HOST=0.0.0.0
OPENBOT_ACCOUNT_PORT=3100
OPENBOT_ACCOUNT_DB=/data/account.sqlite

# The same value as REMOTE_AUTH_WEBHOOK_SECRET in the Signal environment.
OPENBOT_AUTH_WEBHOOK_SECRET=
# Operator token for POST /v2/admin/server-claims. Use at least 48 characters.
OPENBOT_SERVER_CLAIMS_ADMIN_TOKEN=

# The Signal relay that a ticket names. It must use wss://.
OPENBOT_SIGNAL_URL=wss://signal.example.com/v1/signal

# OIDC identity provider. Leave OPENBOT_OIDC_ISSUER empty to disable company sign-in.
OPENBOT_OIDC_ISSUER=
OPENBOT_OIDC_CLIENT_ID=
OPENBOT_OIDC_CLIENT_SECRET=
# The email domain that company sign-in accepts. Empty accepts any domain.
OPENBOT_OIDC_DOMAIN=
# Comma-separated allow-list of emails. Empty accepts each user that the issuer authenticates.
OPENBOT_ALLOWED_EMAILS=

# The owner email that seed.ts uses to make the first server claim.
OPENBOT_BOOTSTRAP_EMAIL=

OPENBOT_TICKET_TTL_SECONDS=300
OPENBOT_AUTH_SESSION_TTL_SECONDS=2592000
